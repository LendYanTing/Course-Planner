# Copy to .env and fill in. NEVER commit the real .env.
#
#   cp env.example .env
#   ./scripts/gen-secrets.sh --write .env      # fills the two CHANGE_ME values
#
# ---- Secrets (required) -----------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_with_gen-secrets.sh
POSTGRES_USER=courseplanner
POSTGRES_PASSWORD=CHANGE_ME_generate_with_gen-secrets.sh
POSTGRES_DB=courseplanner

# ---- Server -----------------------------------------------------------------
LOG_LEVEL=info

# Must stay true in production: the refresh cookie is HttpOnly+Secure, and
# COOKIE_SECURE=false would put it on the wire in cleartext.
COOKIE_SECURE=true

# Comma-separated exact origins of the Web front end. Empty disables CORS
# entirely, which is correct when you only run the MCP/connect page and native
# clients. Never use "*" (docs/security.md §9).
CORS_ALLOWED_ORIGINS=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CONFIRMATION_TTL=10m

# ---- TLS edge ---------------------------------------------------------------
# Domain that deploy/Caddyfile serves. Ignored by the nginx/Tunnel setups.
CP_DOMAIN=cp.example.com

# ---- Bare metal only --------------------------------------------------------
# The compose stack builds DATABASE_URL from the POSTGRES_* values above.
# Kill the comment marks only when configuring /etc/courseplanner/server.env by hand.
# DATABASE_URL=postgres://courseplanner:PASSWORD@127.0.0.1:5432/courseplanner?sslmode=disable
