# Copy to .env and adjust. NEVER commit the real .env.

# ---- Server ----
PORT=8080
# PostgreSQL DSN used by the Go server.
DATABASE_URL=postgres://courseplanner:courseplanner@localhost:5433/courseplanner?sslmode=disable
# HMAC secret for access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me
# Token lifetimes (Go duration syntax).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Comma-separated allowlist. Empty disables CORS entirely.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# How long an MCP change-set confirmation / CSV import preview stays valid.
CONFIRMATION_TTL=10m
LOG_LEVEL=info

# ---- Postgres (docker compose) ----
POSTGRES_USER=courseplanner
POSTGRES_PASSWORD=courseplanner
POSTGRES_DB=courseplanner
POSTGRES_PORT=5433
